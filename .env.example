# Optional overrides for the local server. No secrets belong here.
BALANCER_PORT=8765
BALANCER_DATA_DIR=./data
# Minutes of inactivity before the vault locks itself
BALANCER_IDLE_MINUTES=5
# 1 = also log a short (digit-masked) scraper error message when a sync fails
BALANCER_SCRAPER_DEBUG=0
# Path to Chromium, if not found automatically
# CHROME_PATH=/data/data/com.termux/files/usr/bin/chromium-browser
